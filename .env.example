# Server Configuration
PORT=3000

# MongoDB Configuration (e.g. mongodb+srv://username:password@cluster.mongodb.net/product_marketing or mongodb://127.0.0.1:27017/product_marketing)
MONGODB_URI=mongodb://127.0.0.1:27017/product_marketing
MONGODB_DB=product_marketing

# Cloudinary Configuration (Get these from your Cloudinary Dashboard: https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
